{
  "name": "@workspace/dsh-hsq-develop",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "HSQ development preset with scoped engineering workflows, verification, and personal delivery rules.",
  "engines": { "dsh": ">=0.2.1-rc.2 <0.2.2-0" },
  "exports": {
    ".": "./index.js",
    "./skill-policy": "./skill-policy-runtime.js",
    "./skill-policy/locale/*.json": "./locale/*.json",
    "./skill-policy/icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "skill-policy-runtime.js", "skill-policy-core.js", "cordis.patch.yml", "skills", "locale", "icon.svg", "README.md", "MIGRATION.md", "THIRD_PARTY_NOTICES.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": { "check": "node --check index.js && node --test test/*.test.js" }
}
